{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threewill.github.io/feud/packs/schema.json",
  "title": "Feud show pack",
  "type": "object",
  "required": ["id", "title", "win", "lightning", "boards"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "families": {
      "type": "object",
      "properties": {
        "a": { "type": "string" },
        "b": { "type": "string" }
      }
    },
    "win": {
      "type": "object",
      "required": ["hostCanEnd"],
      "properties": {
        "targetPoints": { "type": ["integer", "null"], "minimum": 1 },
        "hostCanEnd": { "type": "boolean" },
        "onTarget": {
          "type": "string",
          "enum": ["banner", "endAndMaybeLightning"]
        }
      }
    },
    "lightning": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "target": { "type": "integer", "minimum": 1 },
        "player1Seconds": { "type": "integer", "minimum": 1 },
        "player2Seconds": { "type": "integer", "minimum": 1 },
        "steal": { "type": "boolean" },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/board" }
        }
      }
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "required": ["text", "pts"],
      "properties": {
        "text": { "type": "string" },
        "pts": { "type": "integer", "minimum": 0 }
      }
    },
    "board": {
      "type": "object",
      "required": ["id", "question", "answers"],
      "properties": {
        "id": { "type": "string" },
        "pool": { "type": "string", "enum": ["live", "backup"] },
        "source": { "type": "string" },
        "question": { "type": "string" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/answer" }
        }
      }
    }
  }
}
